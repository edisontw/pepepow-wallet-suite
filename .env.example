# ==============================================================================
# PEPEPOW Wallet Suite - Shared Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# IMPORTANT: Never commit your actual .env file to GitHub.

# --- General Service Configuration ---
PORT=9194
NODE_ENV=production

# --- External API Bases ---
# PEPEW Light API base used server-side by Telegram Bot /balance and /history.
PEPEW_LIGHT_API_BASE=https://light.pepepow.net
# PEPEW Light API base baked into the Web Wallet / Telegram Mini App.
VITE_PEPEW_LIGHT_API_BASE_URL=https://light.pepepow.net

# Web base URL for payment links
WALLET_BASE_URL=https://wallet.pepepow.net
# CORS allowlist (comma-separated origins)
CORS_ORIGINS=https://wallet.pepepow.net,https://t.me

# --- Security & Auth ---
# JWT signing secret (use a long random string)
JWT_SECRET=CHANGEME_SET_A_RANDOM_LONG_STRING

# --- Telegram Bot (Optional for Mini App) ---
# Bot token from @BotFather
BOT_TOKEN=123456:AA_REPLACE_ME
# Secret token for webhook validation
BOT_SECRET_TOKEN=CHANGEME_SET_A_RANDOM_64_CHARS
# Max age for initData validation
TELEGRAM_INITDATA_MAX_AGE_SEC=86400

# --- CoinMarketCap (Server-side price API) ---
CMC_API_KEY=REPLACE_ME
CMC_SYMBOL=PEPEW
CMC_CONVERT=USD

# --- Rate Limiting ---
# Windows in milliseconds, max requests per window
WALLET_API_RATE_LIMIT_READ_WINDOW_MS=60000
WALLET_API_RATE_LIMIT_READ_MAX=120
WALLET_API_RATE_LIMIT_AUTH_WINDOW_MS=600000
WALLET_API_RATE_LIMIT_AUTH_MAX=60

# --- Versioning ---
WALLET_API_VERSION=0.2.0
# WALLET_API_GIT_SHA=optional_git_sha
