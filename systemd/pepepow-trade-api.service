[Unit]
Description=PEPEPOW Trade API (DCA Paper Trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pepepow-wallet-suite/services/trade-api
EnvironmentFile=/etc/pepepow/pepepow-trade-api.env
ExecStart=/home/ubuntu/.nvm/versions/node/v20.19.6/bin/node dist/server.js
Restart=always
RestartSec=3
LimitNOFILE=65535
SyslogIdentifier=pepepow-trade-api
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
