[Unit]
Description=PEPEPOW Trade Bot (Telegram DCA Bot)
After=network-online.target pepepow-trade-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pepepow-wallet-suite/services/trade-bot
EnvironmentFile=/etc/pepepow/pepepow-trade-bot.env
ExecStart=/home/ubuntu/.nvm/versions/node/v20.19.6/bin/node /home/ubuntu/pepepow-wallet-suite/services/trade-bot/dist/bot.js
Restart=always
RestartSec=3
LimitNOFILE=65535
SyslogIdentifier=pepepow-trade-bot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
