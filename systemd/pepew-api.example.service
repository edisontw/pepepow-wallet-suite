[Unit]
Description=PEPEW API (Chain Indexer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data

# Path to the current release
WorkingDirectory=/opt/pepepow-wallet-suite/current/pepew-api/pepew-api

# Production secrets live on the host
EnvironmentFile=/etc/pepepow/pepew-api.env

# Path to node and server script
ExecStart=/usr/bin/node /opt/pepepow-wallet-suite/current/pepew-api/pepew-api/dist/index.js

Restart=always
RestartSec=3
LimitNOFILE=65535
SyslogIdentifier=pepew-api
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
