[Unit]
Description=PEPEPOW Wallet API (node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pepepow-wallet-suite/services/wallet-api
EnvironmentFile=/etc/pepepow/pepepow-wallet-api.env
Environment=NODE_ENV=production
ExecStart=/home/ubuntu/.nvm/versions/node/v20.19.6/bin/node dist/server.js
Restart=always
RestartSec=3
LimitNOFILE=65535
SyslogIdentifier=pepepow-wallet-api
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
