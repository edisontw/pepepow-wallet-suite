[Unit]
Description=PEPEW Light API (node)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pepepow-wallet-suite/current
EnvironmentFile=/etc/pepepow/pepew-api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/pepepow-wallet-suite/current/pepew-api/pepew-api/dist/index.js
Restart=always
RestartSec=3
User=www-data
Group=www-data
SyslogIdentifier=pepew-api

[Install]
WantedBy=multi-user.target
