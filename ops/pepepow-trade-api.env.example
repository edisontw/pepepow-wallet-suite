# ==============================================================================
# PEPEPOW Trade API - Environment Configuration
# ==============================================================================
# Copy to /etc/pepepow/pepepow-trade-api.env

# --- Service Configuration ---
PORT=9195

# --- Database ---
# Path to trade-api dedicated DB
TRADE_DB_PATH=/home/ubuntu/pepepow-wallet-suite/services/trade-api/trade.db

# --- Donate Address ---
DONATE_ADDRESS=PDep1ZNhCyqyRwjnQif8K6tPGsE7TvhyT6

# --- Ticker APIs ---
NONKYC_TICKER_URL_BNB=https://api.nonkyc.io/api/v2/ticker/PEPEW_BNB
DEXTRADE_TICKER_URL=https://api.dex-trade.com/v1/public/ticker?pair=PEPEWUSDT
