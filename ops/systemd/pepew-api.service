[Unit]
Description=PEPEW API (node)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pepepow-wallet-suite/pepew-api/pepew-api
EnvironmentFile=/etc/pepepow/pepew-api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/ubuntu/pepepow-wallet-suite/pepew-api/pepew-api/dist/index.js
Restart=always
RestartSec=3
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pepew-api

[Install]
WantedBy=multi-user.target
