# Trade API Environment Variables

# The port the API server will listen on (default: 9195)
PORT=9195

# Path to the SQLite database file (default: trade.db)
# TRADE_DB_PATH=/path/to/your/trade.db

# Encryption key for API keys (32 bytes hex or base64) - REQUIRED
# Generate one with: openssl rand -hex 32
KEYS_ENC_KEY=

# Optional: Donation address displayed in the bot
# DONATE_ADDRESS=PDep1ZNhCyqyRwjnQif8K6tPGsE7TvhyT6

# Optional: Enable detailed strategy status logging
# TRADE_DEBUG_STATUS=true

# --- Exchange API Keys (Only required for running selftest scripts) ---
# NONKYC_API_KEY=
# NONKYC_SECRET=
# DEXTRADE_LOGIN_TOKEN=
# DEXTRADE_SECRET=
# NESTEX_API_KEY=
# NESTEX_API_SECRET=
# NESTEX_API_BASE=https://trade.nestex.one/api/v2
# NESTEX_MIN_INTERVAL_MS=5000
# NESTEX_TICKER_URL=https://api.nestex.one/cg/tickers/PEPEW_USDT
# NESTEX_ORDERBOOK_URL=https://api.nestex.one/cg/orderbook/PEPEW_USDT?depth=100
# NESTEX_PUBLIC_CACHE_MS=30000
